<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 所有包含 UIApplication 的 App 进程都注入；系统进程不会加载。 -->
	<key>Filter</key>
	<dict>
		<key>Classes</key>
		<array>
			<string>UIApplication</string>
		</array>
	</dict>
</dict>
</plist>
